{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "veloplay",
  "version-string": "1.17.1",
  "builtin-baseline": "5d4a3dc90c0b3773f3bac81bf41297b54328f471",
  "dependencies": [
    "openssl",
    "nlohmann-json",
    "spdlog",
    "gtest",
    "miniz",
    "opus",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        {
          "name": "avformat",
          "platform": "linux"
        },
        {
          "name": "swscale",
          "platform": "linux"
        },
        {
          "name": "openh264",
          "platform": "linux"
        }
      ]
    },
    {
      "name": "sdl3",
      "platform": "windows"
    },
    {
      "name": "webview2",
      "platform": "windows"
    },
    {
      "name": "imgui",
      "features": [
        "dx11-binding",
        "win32-binding"
      ],
      "platform": "windows"
    },
    {
      "name": "curl",
      "features": [
        "websockets"
      ],
      "platform": "windows | linux"
    },
    {
      "name": "json-c",
      "platform": "windows | linux"
    },
    {
      "name": "libevent",
      "platform": "windows | linux"
    },
    {
      "name": "miniupnpc",
      "platform": "windows | linux"
    }
  ]
}
