{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "veloplay",
  "version-string": "0.7.1",
  "builtin-baseline": "5d4a3dc90c0b3773f3bac81bf41297b54328f471",
  "dependencies": [
    "openssl",
    "nlohmann-json",
    "spdlog",
    "gtest",
    "miniz",
    "opus",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec"]
    },
    {
      "name": "sdl3",
      "platform": "windows"
    },
    {
      "name": "webview2",
      "platform": "windows"
    },
    {
      "name": "imgui",
      "features": ["dx11-binding", "win32-binding"],
      "platform": "windows"
    }
  ]
}
